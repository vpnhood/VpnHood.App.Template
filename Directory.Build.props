<Project>

  <!-- Your app: its id base, its name, its maker and its version, for every project below. -->
  <Import Project="$(MSBuildThisFileDirectory)app/app.props" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The VpnHood packages, one version for all of them: the one this template is made with,
         unless app/app.props names another. -->
    <VpnHoodVersion Condition="'$(VpnHoodVersion)' == ''">9.0.856</VpnHoodVersion>
  </PropertyGroup>

  <!-- Packages of a VpnHood not yet released, to try the template against before they are: a
       .packages folder beside this file, which git ignores, joins the package sources when it
       exists. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory).packages')">
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory).packages</RestoreAdditionalProjectSources>
  </PropertyGroup>

</Project>
