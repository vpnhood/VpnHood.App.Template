<Project>

  <!-- Your app: its id base, its name, its maker and its version, for every project below. -->
  <Import Project="$(MSBuildThisFileDirectory)app/app.props" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The VpnHood packages, one version for all of them: the one this template is made with,
         unless app/app.props names another. -->
    <VpnHoodVersion Condition="'$(VpnHoodVersion)' == ''">9.1.864</VpnHoodVersion>
    <!-- The VPN host's name, the app's short name and "VpnHost". VpnHood's build gives an app these,
         but a VPN host references nothing of the app, so they are settled here, for both. -->
    <VhAppPackageTitle Condition="'$(VhAppPackageTitle)' == ''">$([System.Text.RegularExpressions.Regex]::Replace('$(VhAppName)', '[^A-Za-z0-9]', ''))</VhAppPackageTitle>
    <VhAppVpnHostName Condition="'$(VhAppVpnHostName)' == ''">$(VhAppPackageTitle)VpnHost</VhAppVpnHostName>
    <!-- The app's settings, app/appsettings.json: VpnApp embeds them, and the VpnHood build reads the
         theme they name (UiTheme) for the colour the app's launch screen shows. -->
    <VhAppSettingsFile>$(MSBuildThisFileDirectory)app/appsettings.json</VhAppSettingsFile>
    <!-- The app's icons, four SVGs in app/icons, which the VpnHood build draws at every size Android
         and iOS ask for. -->
    <VhAppIconsDir>$(MSBuildThisFileDirectory)app/icons</VhAppIconsDir>
  </PropertyGroup>

  <!-- Packages of a VpnHood not yet released, to try the template against before they are: a
       .packages folder beside this file, which git ignores, joins the package sources when it
       exists. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory).packages')">
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory).packages</RestoreAdditionalProjectSources>
  </PropertyGroup>

</Project>
