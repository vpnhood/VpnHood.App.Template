<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>The app for Windows, handed out by your website</Description>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<UseWindowsForms>False</UseWindowsForms>
		<!-- The executable, its service and their folders are called by the app's short name; a Debug
		     build's by the name and "Debug", so it runs beside an installed release
		     (VhAppExecutableName, ../../Directory.Build.props). -->
		<AssemblyName>$(VhAppExecutableName)</AssemblyName>
		<!-- Your website hands this build out, and its id says so (….windows.web). -->
		<VhAppIdChannel>web</VhAppIdChannel>
		<ApplicationIcon>../../app/icons/app.ico</ApplicationIcon>
		<ApplicationManifest>Properties/app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../VpnApp/VpnApp.csproj" />
		<!-- Windows as the app runs on it: the service, the window and its tray, the commands. -->
		<PackageReference Include="VpnHood.AppHosting.Desktop.WindowsTun" Version="$(VpnHoodVersion)" />
		<!-- The VPN host, the VPN service's own process, which the service starts beside this executable:
		     built first and placed beside it, never compiled against. -->
		<ProjectReference Include="../VpnApp.Windows.VpnHost/VpnApp.Windows.VpnHost.csproj" ReferenceOutputAssembly="false" VhAppVpnHost="true" />
		<!-- The UI, in its own window: the host, the pages and the files they draw. -->
		<PackageReference Include="VpnHood.AppHosting.Avalonia.Desktop" Version="$(VpnHoodVersion)" />
		<PackageReference Include="VpnHood.AppUi.Avalonia.Classic" Version="$(VpnHoodVersion)" />
		<PackageReference Include="VpnHood.AppUi.Assets.Classic" Version="$(VpnHoodVersion)" />
		<!-- Sign-in and purchases on your portal. -->
		<PackageReference Include="VpnHood.AppLogic.Portal" Version="$(VpnHoodVersion)" />
	</ItemGroup>
</Project>
