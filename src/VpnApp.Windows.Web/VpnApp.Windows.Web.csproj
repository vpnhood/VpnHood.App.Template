<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>The app for Windows, handed out by your website</Description>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<UseWindowsForms>False</UseWindowsForms>
		<!-- The executable, its service and their folders are called by the app's short name. -->
		<AssemblyName>$(VhAppShortName)</AssemblyName>
		<!-- Your website hands this build out, and its id says so (….windows.web). -->
		<VhAppIdChannel>web</VhAppIdChannel>
		<ApplicationIcon>Resources/app.ico</ApplicationIcon>
		<ApplicationManifest>Properties/app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../VpnApp/VpnApp.csproj" />
		<!-- Windows as the app runs on it: the service, the window and its tray, the commands. -->
		<PackageReference Include="VpnHood.AppUi.Hosting.Cli.Windows" Version="$(VpnHoodVersion)" />
		<!-- The UI, in its own window: the host, the pages and the files they draw. -->
		<PackageReference Include="VpnHood.AppUi.Hosting.Avalonia.Desktop" Version="$(VpnHoodVersion)" />
		<PackageReference Include="VpnHood.AppUi.Presentation.Classic.Avalonia" Version="$(VpnHoodVersion)" />
		<PackageReference Include="VpnHood.AppUi.Assets.Classic" Version="$(VpnHoodVersion)" />
		<!-- Sign-in and purchases on your portal. -->
		<PackageReference Include="VpnHood.AppLib.Portal" Version="$(VpnHoodVersion)" />
	</ItemGroup>
</Project>
