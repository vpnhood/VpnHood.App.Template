<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>The app for Linux, handed out by your website</Description>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<!-- A plain target framework names no platform, so the project does. -->
		<VhAppPlatform>linux</VhAppPlatform>
		<!-- The binary, its service and their folders are called by the app's short name; a Debug
		     build's by the name and "Debug", so it runs beside an installed release
		     (VhAppExecutableName, ../../Directory.Build.props). -->
		<AssemblyName>$(VhAppExecutableName)</AssemblyName>
		<!-- Your website hands this build out, and its id says so (….linux.web). -->
		<VhAppIdChannel>web</VhAppIdChannel>
		<!-- The app's icon, the Windows build's too: the build places its 256 px picture beside the
		     binary, for the tray and the menu entry. -->
		<ApplicationIcon>../../app/icons/app.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../VpnApp/VpnApp.csproj" />
		<!-- Linux as the app runs on it: the service, the window and the commands. -->
		<PackageReference Include="VpnHood.AppLogic.App.Linux" Version="$(VpnHoodVersion)" />
		<PackageReference Include="VpnHood.AppHosting.Desktop.Linux" Version="$(VpnHoodVersion)" />
		<!-- The VPN host, the VPN service's own process, which the service starts beside this binary:
		     built first and placed beside it, never compiled against. -->
		<ProjectReference Include="../VpnApp.Linux.VpnHost/VpnApp.Linux.VpnHost.csproj" ReferenceOutputAssembly="false" VhAppVpnHost="true" />
		<!-- The UI, in its own window: the host, the pages and the files they draw. -->
		<PackageReference Include="VpnHood.AppHosting.Avalonia.Desktop" Version="$(VpnHoodVersion)" />
		<PackageReference Include="VpnHood.AppUi.Avalonia.Classic" Version="$(VpnHoodVersion)" />
		<PackageReference Include="VpnHood.AppUi.Assets.Classic" Version="$(VpnHoodVersion)" />
		<!-- Sign-in and purchases on your portal. -->
		<PackageReference Include="VpnHood.AppLogic.Portal" Version="$(VpnHoodVersion)" />
	</ItemGroup>
</Project>
