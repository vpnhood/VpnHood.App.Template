<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>The VPN service of the app for Windows, in a process of its own</Description>
		<OutputType>WinExe</OutputType>
		<!-- The Windows build's own, as both executables run from one folder: each package they share
		     then comes in the same build for both. -->
		<TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<!-- The service starts it by this name, which the app's own assembly records. -->
		<AssemblyName>$(VhAppVpnHostName)</AssemblyName>
		<ApplicationIcon>../../app/icons/app.ico</ApplicationIcon>
		<!-- It draws nothing, so it takes none of the app's own files (Directory.Build.targets). -->
		<VpnAppIsApp>false</VpnAppIsApp>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="VpnHood.Core.Client.VpnServices.Host.WindowsTun" Version="$(VpnHoodVersion)" />
	</ItemGroup>
</Project>
