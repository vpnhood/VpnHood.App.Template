<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>The app for Android, as the APK your website hands out</Description>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0-android37.0</TargetFramework>
		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		<!-- Your website hands this build out, and its id says so (….android.web), apart from the
		     Play build's. -->
		<VhAppIdChannel>web</VhAppIdChannel>
		<!-- A website hands out an APK, never Play's bundle. -->
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<!-- android-arm is still what some Android TVs run. -->
		<RuntimeIdentifiers>android-arm64;android-x64;android-arm</RuntimeIdentifiers>
		<PublishTrimmed>True</PublishTrimmed>
	</PropertyGroup>

	<!-- -p:VpnAppArm64Apk=true: the arm64 APK, a third the size, which arm64 phones update from. -->
	<PropertyGroup Condition="'$(VpnAppArm64Apk)'=='true'">
		<RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
	</PropertyGroup>

	<!-- A publish writes the update feed beside the APK. -->
	<Import Project="UpdateFeed.targets" />

	<ItemGroup>
		<ProjectReference Include="../VpnApp/VpnApp.csproj" />
		<!-- Android as the app runs on it: the device, the tile. -->
		<PackageReference Include="VpnHood.AppLogic.App.Android" Version="$(VpnHoodVersion)" />
		<!-- The VPN service, which the APK carries beside the app. -->
		<PackageReference Include="VpnHood.Core.Client.VpnServices.Host.Android" Version="$(VpnHoodVersion)" />
		<!-- The UI, as the app's activity: the host, the pages and the files they draw. -->
		<PackageReference Include="VpnHood.AppHosting.Avalonia.Android" Version="$(VpnHoodVersion)" />
		<PackageReference Include="VpnHood.AppUi.Avalonia.Classic" Version="$(VpnHoodVersion)" />
		<PackageReference Include="VpnHood.AppUi.Assets.Classic" Version="$(VpnHoodVersion)" />
		<!-- Sign-in and purchases on your portal. -->
		<PackageReference Include="VpnHood.AppLogic.Portal" Version="$(VpnHoodVersion)" />
		<!-- The app downloads and installs its own update: never in a store's build, as it asks for
		     REQUEST_INSTALL_PACKAGES, which Google Play forbids for an app's own updates. -->
		<PackageReference Include="VpnHood.AppLogic.Stores.AndroidWeb" Version="$(VpnHoodVersion)" />
	</ItemGroup>
</Project>
